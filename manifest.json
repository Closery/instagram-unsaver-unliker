{
	"manifest_version": 3,
	"name": "Instagram Unsaver & Unliker",
	"version": "0.2.0",
	"description": "Bulk unsave your Instagram saved posts from the post viewer. Bulk unlike is coming next.",
	"permissions": ["storage"],
	"icons": {
		"16": "icons/icon16.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"content_scripts": [
		{
			"matches": ["*://*.instagram.com/*"],
			"run_at": "document_idle",
			"js": ["src/content.js"],
			"css": ["src/content.css"]
		}
	]
}
